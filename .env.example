# Salin file ini menjadi .env lalu isi. JANGAN commit .env ke Git.

# Base URL API provider yang kompatibel OpenAI (OpenAI resmi, OpenRouter, reseller, server lokal).
# Ambil dari dashboard/dokumentasi providermu. Contoh bentuk: https://.../v1 (tanpa slash akhir)
# CATATAN: dotenv tidak menimpa variabel yang sudah ada di shell - kalau kamu punya
# OPENAI_API_KEY global dan mau router pakai key lain, jalankan dengan env bersih.
OPENAI_BASE_URL=
OPENAI_API_KEY=

# Nama model persis seperti di daftar /models providermu (cek dulu, nama di bawah hanya contoh)
LIGHT_MODEL=deepseek-v4-flash
HEAVY_MODEL=deepseek-v4-pro

# Kunci lokal opsional: kalau diisi, request ke router ini wajib membawa
# "Authorization: Bearer <kunci ini>". Isi juga di kolom API key Hermes.
LOCAL_API_KEY=

# Kebijakan thinking: kirim THINKING tag apa yang di log decisions.jsonl
# - tier light: param thinking (reasoning_effort/thinking/...) otomatis DIBUANG sebelum forward
# - tier heavy: klien boleh thinking; kalau kosong dan nilai diisi (mis. high), router
#   mengisi reasoning_effort sendiri. Kosongkan kalau model upstream menolak param ini.
HEAVY_REASONING_EFFORT=

# Skor minimal agar tugas dianggap berat (naikkan = lebih hemat, turunkan = lebih aman kualitas)
HEAVY_THRESHOLD=3

# Lokasi log keputusan routing (tanpa isi prompt)
LOG_PATH=logs/decisions.jsonl

# URL yang ditampilkan ke user / dipakai client dari luar (mis. VPS: https://domain/v1).
# Kosong = pakai http://127.0.0.1:<BIND_PORT>/v1
PUBLIC_BASE_URL=

# Alamat & port server. Untuk VPS: BIND_HOST=0.0.0.0 (WAJIB isi LOCAL_API_KEY + HTTPS via reverse proxy)
BIND_HOST=127.0.0.1
BIND_PORT=8000
